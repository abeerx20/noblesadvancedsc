rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // كل عمليات النظام تمر عبر الباك إند بعد التحقق من Firebase ID Token.
    // Firebase Admin SDK يتجاوز هذه القواعد من بيئة الخادم الموثوقة فقط.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

